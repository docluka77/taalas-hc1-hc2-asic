# =============================================================================
# Stage 23 Yosys Formal SAT Proof Script — All 6 Literature/Spec Audit Fixes
# Proves AUDIT-FINDING-001..006 across rtl_v3/*.sv & rtl_hc2/*.sv (SAT Q.E.D.)
# =============================================================================

# --- 1. AUDIT-FINDING-001: taalas_via_mask_rom_macro (M01: Bitline/WL Interlock) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_via_mask_rom_macro.sv
chparam -set NUM_BANKS 2 -set ROWS 2 -set COLS 320 taalas_via_mask_rom_macro
prep -top taalas_via_mask_rom_macro
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 6 -set-init-zero -prove-asserts

# --- 2. AUDIT-FINDING-002: taalas_mxfp4_hc2_mac_lane (M03: OCP MX E8M0=8'hFF NaN) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_mxfp4_hc2_mac_lane.sv
chparam -set BLOCK_SIZE 4 -set NUM_LANES 1 taalas_mxfp4_hc2_mac_lane
prep -top taalas_mxfp4_hc2_mac_lane
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 6 -set-init-zero -prove-asserts

# --- 3A. AUDIT-FINDING-003: taalas_sram_6t_banked_macro (M05: 72-bit SECDED + MBU DED) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_sram_6t_banked_macro.sv
chparam -set NUM_BANKS 2 -set BANK_DEPTH 2 taalas_sram_6t_banked_macro
prep -top taalas_sram_6t_banked_macro
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 2 -set-init-zero -prove-asserts
sat -verify -seq 6 -set-init-zero -prove-asserts -set err_inj_mask_i 72'h49_0000_0000_0000_0000

# --- 3B. AUDIT-FINDING-003: taalas_hc2_disagg_sram_fabric (H1: 72-bit SECDED + MBU DED) ---
design -reset
read_verilog -sv -formal rtl_hc2/taalas_hc2_disagg_sram_fabric.sv
chparam -set NUM_PORTS 2 -set NUM_BANKS 4 -set BANK_DEPTH 2 -set MAX_USERS 2 taalas_hc2_disagg_sram_fabric
prep -top taalas_hc2_disagg_sram_fabric
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 4 -set-init-zero -prove-asserts

# --- 3C. AUDIT-FINDING-003: taalas_ecc_bist_scrubber (M18: Scrubber SBE/DBE/MBU Guard) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_ecc_bist_scrubber.sv
chparam -set NUM_BANKS 2 -set BANK_DEPTH 4 -set ROM_DEPTH 4 taalas_ecc_bist_scrubber
prep -top taalas_ecc_bist_scrubber
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 6 -set-init-zero -prove-asserts

# --- 4. AUDIT-FINDING-004: taalas_rope_cordic_unit (M08: Llama-3.1 Per-Lane RoPE) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_rope_cordic_unit.sv
chparam -set PAIR_LANES 2 taalas_rope_cordic_unit
prep -top taalas_rope_cordic_unit
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 4 -set-init-zero -prove-asserts

# --- 5. AUDIT-FINDING-005: taalas_flash_decode_attention (M09: CSD log2(e) Scaling) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_flash_decode_attention.sv
chparam -set HEAD_DIM 2 -set GQA_RATIO 1 taalas_flash_decode_attention
prep -top taalas_flash_decode_attention
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 6 -set-init-zero -prove-asserts

# --- 6. AUDIT-FINDING-006: taalas_hc2_moe_mla_router (H3: DeepSeek-R1 Biased TopK) ---
design -reset
read_verilog -sv -formal rtl_hc2/taalas_hc2_moe_mla_router.sv
chparam -set NUM_EXPERTS 4 -set DIM_GATE 4 -set MAX_K 4 -set NUM_CHIPS 2 taalas_hc2_moe_mla_router
prep -top taalas_hc2_moe_mla_router
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 4 -set-init-zero -prove-asserts
