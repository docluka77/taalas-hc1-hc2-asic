# --- 8. BUG-HC1-008: taalas_hc1_layer_tile (M14) & taalas_hc1_chip_top (M15) ---
design -reset
read_verilog -sv -formal rtl_v3/taalas_hc1_layer_tile.sv
delete taalas_hc1_layer_tile/c:u_*
prep -top taalas_hc1_layer_tile
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 8 -set-init-zero -prove-asserts

design -reset
read_verilog -sv -formal rtl_v3/taalas_hc1_chip_top.sv
delete taalas_hc1_chip_top/c:u_* taalas_hc1_chip_top/c:gen_*
prep -top taalas_hc1_chip_top
memory_map; async2sync; dffunmap; opt -full
sat -verify -seq 8 -set-init-zero -prove-asserts
