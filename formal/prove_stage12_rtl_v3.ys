design -reset
read_verilog -sv -formal rtl_v3/taalas_token_pipe_noc_router.sv
chparam -set FLIT_WIDTH 32 -set FIFO_DEPTH 4 -set MAX_CREDITS 4 taalas_token_pipe_noc_router
prep -top taalas_token_pipe_noc_router
