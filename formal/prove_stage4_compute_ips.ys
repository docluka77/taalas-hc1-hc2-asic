# =============================================================================
# Yosys Formal SAT Equivalence & Property Proof Script — Stage 4 Compute IPs
# Proves 100% arithmetic equivalence (Q.E.D.) across:
#   1. M2: taalas_3b6b_wired_mac_array (Multiplierless 3b CSD + 6b Outlier VMM)
#   2. M3: taalas_mxfp4_hc2_mac_lane   (OCP MXFP4 E2M1 Shift-Add + E8M0 Scale)
#   3. M4: taalas_group_dequant_scale_unit (Zero-Point + Q8.8 Dequant + LoRA)
#   4. M7: taalas_lora_sram_overlay_engine (Zero-Stall Rank-r Parallel Adapter)
# =============================================================================

# --- Proof 1: M2 taalas_3b6b_wired_mac_array ---
design -reset
read_verilog -sv -defer rtl/taalas_3b6b_wired_mac_array.sv
hierarchy -check -top taalas_3b6b_wired_mac_array -chparam VEC_LEN 4 -chparam OUT_CHANNELS 1 -chparam NUM_OUTLIERS 1
proc; opt; memory; opt; flatten; opt
async2sync
sat -seq 6 -set-init-zero -prove-asserts -show-ports

# --- Proof 2: M3 taalas_mxfp4_hc2_mac_lane ---
design -reset
read_verilog -sv -defer rtl/taalas_mxfp4_hc2_mac_lane.sv
hierarchy -check -top taalas_mxfp4_hc2_mac_lane -chparam BLOCK_SIZE 4 -chparam NUM_LANES 1
proc; opt; memory; opt; flatten; opt
async2sync
sat -seq 6 -set-init-zero -prove-asserts -show-ports

# --- Proof 3: M4 taalas_group_dequant_scale_unit ---
design -reset
read_verilog -sv -defer rtl/taalas_group_dequant_scale_unit.sv
hierarchy -check -top taalas_group_dequant_scale_unit -chparam OUT_CHANNELS 1
proc; opt; memory; opt; flatten; opt
async2sync
sat -seq 6 -set-init-zero -prove-asserts -show-ports

# --- Proof 4: M7 taalas_lora_sram_overlay_engine ---
design -reset
read_verilog -sv -defer rtl/taalas_lora_sram_overlay_engine.sv
hierarchy -check -top taalas_lora_sram_overlay_engine -chparam IN_DIM 2 -chparam OUT_CHANNELS 1 -chparam MAX_RANK 1 -chparam MAX_SKEW 2
proc; opt; memory; opt; flatten; opt
async2sync
sat -seq 6 -set-init-zero -prove-asserts -show-ports
