hierarchy -check -top taalas_rmsnorm_engine -chparam HIDDEN_DIM 16 -chparam VEC_W 8 -chparam DATA_W 16 -chparam EPS_DEFAULT 4;
flatten;
chformal -remove;
proc; opt -fast; fsm; opt -fast; memory -nomap; opt_clean; memory_map; opt -fast; techmap; opt -fast;
ltp;
dfflibmap -liberty synth/lib/NangateOpenCellLibrary_typical.lib;
abc -D 1333 -liberty synth/lib/NangateOpenCellLibrary_typical.lib -script +strash;scorr;dc2;strash;&get,-n;&dch,-f;&nf,{D};&put;buffer;upsize,{D};dnsize,{D};topo;stime,-p;print_stats;
stat -liberty synth/lib/NangateOpenCellLibrary_typical.lib;
write_verilog -noattr -noexpr synth/netlists/taalas_rmsnorm_engine_nangate_45nm_netlist.v;
