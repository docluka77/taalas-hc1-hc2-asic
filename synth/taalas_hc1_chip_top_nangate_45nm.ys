read_liberty -lib synth/lib/NangateOpenCellLibrary_typical.lib;
read_verilog -sv -DYOSYS -defer rtl/taalas_via_mask_rom_macro.sv rtl/taalas_3b6b_wired_mac_array.sv rtl/taalas_mxfp4_hc2_mac_lane.sv rtl/taalas_group_dequant_scale_unit.sv rtl/taalas_sram_6t_banked_macro.sv rtl/taalas_kv_cache_manager.sv rtl/taalas_lora_sram_overlay_engine.sv rtl/taalas_rope_cordic_unit.sv rtl/taalas_flash_decode_attention.sv rtl/taalas_rmsnorm_engine.sv rtl/taalas_swiglu_ffn_pipe.sv rtl/taalas_token_pipe_noc_router.sv rtl/taalas_pcie_csr_ctrl.sv rtl/taalas_hc1_layer_tile.sv rtl/taalas_hc1_chip_top.sv;
hierarchy -check -top taalas_hc1_chip_top -chparam NUM_LAYERS_PARAM 2 -chparam FLIT_WIDTH 128 -chparam HIDDEN_DIM 16 -chparam HEAD_DIM 16 -chparam GQA_RATIO 4;
setattr -mod -set blackbox 1 taalas_via_mask_rom_macro taalas_3b6b_wired_mac_array taalas_mxfp4_hc2_mac_lane taalas_group_dequant_scale_unit taalas_sram_6t_banked_macro taalas_kv_cache_manager taalas_lora_sram_overlay_engine taalas_rope_cordic_unit taalas_flash_decode_attention taalas_rmsnorm_engine taalas_swiglu_ffn_pipe taalas_token_pipe_noc_router taalas_pcie_csr_ctrl taalas_hc1_layer_tile;
chformal -remove;
proc; opt -fast; fsm; opt -fast; memory -nomap; opt_clean; opt -fast; techmap; opt -fast;
ltp;
dfflibmap -liberty synth/lib/NangateOpenCellLibrary_typical.lib;
abc -D 1333 -liberty synth/lib/NangateOpenCellLibrary_typical.lib -script +strash;map;topo;stime,-p;print_stats;
stat -liberty synth/lib/NangateOpenCellLibrary_typical.lib;
write_verilog -noattr -noexpr synth/netlists/taalas_hc1_chip_top_nangate_45nm_netlist.v;
