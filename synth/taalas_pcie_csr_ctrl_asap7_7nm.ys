read_liberty -lib synth/lib/asap7_rvt_ff.lib;
read_verilog -sv -DYOSYS -defer rtl/taalas_pcie_csr_ctrl.sv;
hierarchy -check -top taalas_pcie_csr_ctrl -chparam ADDR_WIDTH 16 -chparam DATA_WIDTH 32 -chparam TOKEN_FIFO_DEPTH 16;
flatten;
chformal -remove;
proc; opt -fast; fsm; opt -fast; memory -nomap; opt_clean; memory_map; opt -fast; techmap; opt -fast;
ltp;
dfflibmap -liberty synth/lib/asap7_rvt_ff.lib;
abc -D 714 -liberty synth/lib/asap7_rvt_ff.lib -script +strash;scorr;dc2;strash;&get,-n;&dch,-f;&nf,{D};&put;buffer;upsize,{D};dnsize,{D};topo;stime,-p;print_stats;
stat -liberty synth/lib/asap7_rvt_ff.lib;
write_verilog -noattr -noexpr synth/netlists/taalas_pcie_csr_ctrl_asap7_7nm_netlist.v;
