hierarchy -check -top taalas_via_mask_rom_macro -chparam NUM_BANKS 2 -chparam ROWS 4 -chparam COLS 64 -chparam COLS_3B 8 -chparam OUTLIER_SLOTS 2;
flatten;
chformal -remove;
proc; opt -fast; fsm; opt -fast; memory -nomap; opt_clean; opt -fast; techmap; opt -fast;
ltp;
dfflibmap -liberty synth/lib/NangateOpenCellLibrary_typical.lib;
abc -D 1333 -liberty synth/lib/NangateOpenCellLibrary_typical.lib -script +strash;scorr;dc2;strash;&get,-n;&dch,-f;&nf,{D};&put;buffer;upsize,{D};dnsize,{D};topo;stime,-p;print_stats;
stat -liberty synth/lib/NangateOpenCellLibrary_typical.lib;
