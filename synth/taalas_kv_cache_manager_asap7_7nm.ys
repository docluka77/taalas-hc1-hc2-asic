read_liberty -lib synth/lib/asap7_rvt_ff.lib;
read_verilog -sv -DYOSYS -defer rtl/taalas_kv_cache_manager.sv;
hierarchy -check -top taalas_kv_cache_manager -chparam MAX_USERS 2 -chparam MAX_SEQ_LEN 4 -chparam NUM_KV_HEADS 4 -chparam GQA_RATIO 4 -chparam HEAD_DIM 8;
flatten;
chformal -remove;
proc; opt -fast; fsm; opt -fast; memory -nomap; opt_clean; opt -fast; techmap; opt -fast;
ltp;
dfflibmap -liberty synth/lib/asap7_rvt_ff.lib;
abc -D 714 -liberty synth/lib/asap7_rvt_ff.lib -script +strash;scorr;dc2;strash;&get,-n;&dch,-f;&nf,{D};&put;buffer;upsize,{D};dnsize,{D};topo;stime,-p;print_stats;
stat -liberty synth/lib/asap7_rvt_ff.lib;
write_verilog -noattr -noexpr synth/netlists/taalas_kv_cache_manager_asap7_7nm_netlist.v;
