read_liberty -lib synth/lib/asap7_rvt_ff.lib;
read_verilog -sv -DYOSYS -defer rtl/taalas_flash_decode_attention.sv;
hierarchy -check -top taalas_flash_decode_attention -chparam HEAD_DIM 4 -chparam GQA_RATIO 1 -chparam DATA_W 16;
flatten;
chformal -remove;
proc; opt -fast; fsm; opt -fast; memory -nomap; opt_clean; memory_map; opt -fast; techmap; opt -fast;
ltp;
dfflibmap -liberty synth/lib/asap7_rvt_ff.lib;
abc -D 714 -liberty synth/lib/asap7_rvt_ff.lib -script +strash;map;topo;stime,-p;print_stats;
stat -liberty synth/lib/asap7_rvt_ff.lib;
write_verilog -noattr -noexpr synth/netlists/taalas_flash_decode_attention_asap7_7nm_netlist.v;
